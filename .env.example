# Copy this file to .env.local and replace every placeholder before enabling integrations.
# Never commit .env.local or expose server secrets through NEXT_PUBLIC_ variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_ENCRYPTION_KEY=generate-a-random-secret-with-at-least-32-bytes

# Spotify: create a Web API app in the Spotify Developer Dashboard.
# Use the same app Client ID for both variables; only the NEXT_PUBLIC_ one is used by the browser SDK.
SPOTIFY_CLIENT_ID=your_spotify_client_id
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Add this exact URL to Spotify Dashboard > Settings > Redirect URIs.
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback

# Google / YouTube: create an OAuth 2.0 Web application client and enable YouTube Data API v3.
# OAuth is used for a user's playlists; the API key is used for public catalog search.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Add this exact URL to Google Cloud Console > Credentials > Authorized redirect URIs.
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Apple MusicKit JS: create a MusicKit private key in Apple Developer > MusicKit.
# The server signs short-lived developer tokens from these values. MusicKit user auth is a browser consent flow.
# Apple MusicKit does not use a client ID/secret or OAuth redirect URI in this integration; allow your app domain in Apple Developer.
APPLE_MUSIC_TEAM_ID=your_apple_developer_team_id
APPLE_MUSIC_KEY_ID=your_musickit_key_id
# Paste the .p8 contents; preserve newlines or encode them as \\n.
APPLE_MUSIC_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\\nreplace_with_private_key_contents\\n-----END PRIVATE KEY-----
